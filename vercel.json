{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mycharters-website.vercel.app"
        }
      ],
      "destination": "https://mychartersmlt.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "mycharters-website.vercel.app"
        }
      ],
      "destination": "https://mychartersmlt.com/:path+",
      "permanent": true
    }
  ]
}
